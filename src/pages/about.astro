---
import Layout from '../layouts/Layout.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Sergei Tikhomirov",
  "jobTitle": "IT Project & Delivery Manager",
  "location": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Belgrade",
      "addressCountry": "Serbia"
    }
  },
  "url": "https://letterlab.netlify.app/about",
  "sameAs": [
    "https://www.linkedin.com/in/sergei-tikhomirov-pm/",
    "https://github.com/Sidspirit/letterlab"
  ],
  "knowsAbout": [
    "IT Project Management",
    "Software Delivery Management",
    "Web Application Development",
    "Frontend Technologies",
    "Digital Product Design"
  ]
};
---

<Layout 
  title="About Sergei Tikhomirov - Creator of Letter Lab" 
  description="Learn more about Sergei Tikhomirov, IT Project & Delivery Manager based in Belgrade, Serbia, and creator of the Letter Lab web utility."
>
  <div class="px-4 md:px-20 flex flex-1 justify-center py-10">
    <div class="layout-content-container flex flex-col max-w-[800px] flex-1">
      
      <!-- HERO ABOUT -->
      <section class="flex flex-col md:flex-row items-center gap-8 mb-12 border-b border-[#f0f2f4] pb-10">
        <div class="w-40 h-40 md:w-48 md:h-48 rounded-2xl overflow-hidden border-2 border-[#e4e6e8] shadow-sm flex-shrink-0">
          <img 
            src="/images/sergei-tikhomirov.jpg" 
            alt="Sergei Tikhomirov - IT Project & Delivery Manager" 
            class="w-full h-full object-cover"
          />
        </div>
        <div class="flex flex-col text-center md:text-left">
          <span class="px-3 py-1 text-xs font-semibold tracking-wide text-[#3289e7] bg-[#eef5fc] rounded-full uppercase w-fit mx-auto md:mx-0 mb-3">
            Creator & Developer
          </span>
          <h1 class="text-[#111418] text-3xl md:text-4xl font-extrabold tracking-tight mb-2">
            Sergei Tikhomirov
          </h1>
          <p class="text-[#3289e7] font-semibold text-base mb-3">
            IT Project & Delivery Manager
          </p>
          <p class="text-[#637588] text-sm leading-relaxed mb-4">
            Passionate about building efficient web tools, streamlining digital workflows, and delivering high-quality software solutions with a focus on speed, clarity, and user privacy.
          </p>
          <div class="flex flex-wrap gap-3 justify-center md:justify-start">
  <!-- LinkedIn Button -->
  <a 
    href="https://www.linkedin.com/in/sergei-tikhomirov-pm/" 
    target="_blank" 
    rel="noopener noreferrer"
    class="flex items-center gap-2 rounded-xl bg-[#0077b5] hover:bg-[#005f93] px-4 py-2 text-xs font-bold text-white transition-colors shadow-sm"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z"/>
    </svg>
    <span>LinkedIn Profile</span>
  </a>

  <!-- GitHub Button -->
  <a 
    href="https://github.com/Sidspirit/letterlab" 
    target="_blank" 
    rel="noopener noreferrer"
    class="flex items-center gap-2 rounded-xl bg-[#24292e] hover:bg-[#1b1f23] px-4 py-2 text-xs font-bold text-white transition-colors shadow-sm"
  >
    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
      <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
    </svg>
    <span>GitHub Repository</span>
  </a>
</div>
        </div>
      </section>

      <!-- ABOUT PROJECT PHILOSOPHY -->
      <section class="space-y-6 mb-12">
        <h2 class="text-[#111418] text-2xl font-bold tracking-tight">Why Letter Lab Was Built</h2>
        <p class="text-[#637588] text-base leading-relaxed">
          <strong>Letter Lab</strong> was designed to fill a gap in everyday digital productivity tools. Many existing text converters are cluttered with invasive advertisements, load slowly, or upload user data to external servers for processing.
        </p>
        <p class="text-[#637588] text-base leading-relaxed">
          As an IT Delivery Manager, I prioritize performance, data integrity, and intuitive UI/UX. Letter Lab was built on three core engineering principles:
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-xl border border-[#e4e6e8] bg-[#f8fafc]">
            <h3 class="text-[#111418] font-bold text-sm mb-1">100% Client-Side</h3>
            <p class="text-[#637588] text-xs leading-relaxed">Every operation executes inside your browser DOM. No text is ever transmitted over the network.</p>
          </div>
          <div class="p-4 rounded-xl border border-[#e4e6e8] bg-[#f8fafc]">
            <h3 class="text-[#111418] font-bold text-sm mb-1">Sub-Second Speed</h3>
            <p class="text-[#637588] text-xs leading-relaxed">Built with Astro and lightweight TypeScript for near-instant rendering and processing.</p>
          </div>
          <div class="p-4 rounded-xl border border-[#e4e6e8] bg-[#f8fafc]">
            <h3 class="text-[#111418] font-bold text-sm mb-1">Clean & Accessible</h3>
            <p class="text-[#637588] text-xs leading-relaxed">Designed with Tailwind CSS for seamless responsiveness across mobile and desktop interfaces.</p>
          </div>
        </div>
      </section>

      <!-- EXPERTISE & BACKGROUND -->
      <section class="border-t border-[#f0f2f4] pt-8 mb-10">
        <h2 class="text-[#111418] text-2xl font-bold tracking-tight mb-4">Professional Focus</h2>
        <p class="text-[#637588] text-base leading-relaxed mb-4">
          With extensive experience leading web development, e-commerce integrations, and technical delivery teams, I focus on bridging business requirements with clean technical execution.
        </p>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-[#f0f2f4] text-[#111418] text-xs font-semibold rounded-lg">IT Project Management</span>
          <span class="px-3 py-1 bg-[#f0f2f4] text-[#111418] text-xs font-semibold rounded-lg">Delivery Management</span>
          <span class="px-3 py-1 bg-[#f0f2f4] text-[#111418] text-xs font-semibold rounded-lg">Agile & Scrum</span>
          <span class="px-3 py-1 bg-[#f0f2f4] text-[#111418] text-xs font-semibold rounded-lg">Web Applications</span>
          <span class="px-3 py-1 bg-[#f0f2f4] text-[#111418] text-xs font-semibold rounded-lg">Frontend Integration</span>
        </div>
      </section>

    </div>
  </div>

  <!-- Schema.org JSON-LD for E-E-A-T -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</Layout>