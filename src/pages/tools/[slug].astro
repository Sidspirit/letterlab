---
import tools from '../../data/tools.json';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const currentSlug = tool.slug;

// Выводим ВСЕ остальные инструменты для максимальной перелинковки
const relatedTools = tools.filter(t => t.slug !== currentSlug);
---

<Layout title={tool.title} description={tool.description}>
  <div class="px-4 md:px-40 flex flex-1 justify-center py-5">
    <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
      <h1 class="text-[#111418] tracking-light text-[32px] font-bold leading-tight px-4 text-center pb-3 pt-6">
        {tool.h1}
      </h1>
      <p class="text-[#111418] text-base font-normal leading-normal pb-3 pt-1 px-4 text-center">
        {tool.introText}
      </p>

      <!-- Ввод текста -->
      <div class="flex max-w-[960px] flex-wrap items-end gap-4 px-4 py-3">
        <label class="flex flex-col min-w-40 flex-1">
          <p class="text-[#111418] text-base font-medium leading-normal pb-2">Enter your text here</p>
          <textarea placeholder="Type or paste your text here..." id="inputText"
            class="form-input flex w-full min-w-0 flex-1 resize-y rounded-xl text-[#111418] focus:outline-0 focus:ring-0 border border-[#dce0e5] bg-white focus:border-[#dce0e5] min-h-36 placeholder:text-[#637588] p-[15px] text-base font-normal leading-normal"></textarea>
        </label>
      </div>

      <!-- Вывод результата -->
      <div class="flex max-w-[960px] flex-wrap items-end gap-4 px-4 py-3">
        <label class="flex flex-col min-w-40 flex-1">
          <p class="text-[#111418] text-base font-medium leading-normal pb-2">Result</p>
          <textarea placeholder="Your result will appear here automatically..." id="outputText" readonly
            class="form-input flex w-full min-w-0 flex-1 resize-y rounded-xl text-[#111418] focus:outline-0 focus:ring-0 border border-[#dce0e5] bg-white focus:border-[#dce0e5] min-h-36 placeholder:text-[#637588] p-[15px] text-base font-normal leading-normal"></textarea>
        </label>
      </div>

      <!-- Кнопка копирования -->
      <div class="flex px-4 py-3 justify-end">
        <button id="copyBtn" type="button"
          class="flex min-w-[120px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-xl h-10 px-4 bg-[#3289e7] hover:bg-[#2776cc] text-white text-sm font-bold leading-normal tracking-[0.015em] transition-colors">
          <span class="truncate" id="copyBtnText">Copy Result</span>
        </button>
      </div>

      <!-- Блок перелинковки со всеми инструментами -->
      <div class="px-4 py-6 mt-4 border-t border-[#f0f2f4]">
        <p class="text-[#111418] text-sm font-semibold leading-normal pb-3 text-center sm:text-left">
          Other Useful Text Tools:
        </p>
        <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
          {relatedTools.map((t) => (
            <a
              href={`/tools/${t.slug}`}
              class="flex items-center rounded-xl bg-[#f0f2f4] hover:bg-[#e4e6e8] px-3 py-2 text-xs font-medium text-[#111418] transition-colors"
            >
              {t.title.replace(' - Letter Lab', '').replace(' Converter', '').replace(' Generator', '')}
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>

  <script define:vars={{ slug: currentSlug }}>
    function transformText(val, currentSlug) {
      if (!val) return '';

      switch (currentSlug) {
        case 'uppercase':
          return val.toUpperCase();
        case 'lowercase':
          return val.toLowerCase();
        case 'sentence-case': {
          let text = val.toLowerCase();
          if (text.length > 0) text = text.charAt(0).toUpperCase() + text.slice(1);
          return text.replace(/([.!?]\s+)([a-zа-яёäöüßéèàçšžčćđñğışъьюя])/gi, (_, p1, p2) => p1 + p2.toUpperCase());
        }
        case 'title-case':
          return val.toLowerCase().split(' ').map(w => w ? w.charAt(0).toUpperCase() + w.slice(1) : '').join(' ');
        case 'slugify':
          return val.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/[\s_-]+/g, '-').replace(/^-+|-+$/g, '');
        case 'camelcase':
          return val.toLowerCase().replace(/[^a-zA-Z0-9]+(.)/g, (_, chr) => chr.toUpperCase());
        case 'snakecase':
          return val.toLowerCase().trim().replace(/[^\w\s]/g, '').replace(/\s+/g, '_');
        case 'kebabcase':
          return val.toLowerCase().trim().replace(/[^\w\s]/g, '').replace(/\s+/g, '-');
        case 'remove-extra-spaces':
          return val.replace(/\s+/g, ' ').trim();
        case 'reverse-text':
          return val.split('').reverse().join('');
        case 'word-counter': {
          const words = val.trim() ? val.trim().split(/\s+/).length : 0;
          const chars = val.length;
          const lines = val ? val.split('\n').length : 0;
          return `Words: ${words}\nCharacters: ${chars}\nLines: ${lines}`;
        }
        case 'remove-line-breaks':
          return val.replace(/[\r\n]+/g, ' ');
        case 'capitalize-first-letter':
          return val.split('\n').map(line => line ? line.charAt(0).toUpperCase() + line.slice(1) : '').join('\n');
        case 'alternate-case':
          return val.split('').map((char, i) => i % 2 === 0 ? char.toLowerCase() : char.toUpperCase()).join('');
        case 'base64-encode':
          try { return btoa(unescape(encodeURIComponent(val))); } catch (e) { return 'Error encoding Base64'; }
        case 'remove-duplicate-lines':
          return Array.from(new Set(val.split('\n'))).join('\n');
        case 'trim-whitespace':
          return val.split('\n').map(line => line.trim()).join('\n').trim();
        case 'remove-numbers':
          return val.replace(/[0-9]/g, '');
        case 'remove-punctuation':
          return val.replace(/[^\w\s\n]|_/g, '');
        case 'url-encode':
          return encodeURIComponent(val);
        default:
          return val;
      }
    }

    function initScript() {
      const inputText = document.getElementById('inputText');
      const outputText = document.getElementById('outputText');
      const copyBtn = document.getElementById('copyBtn');
      const copyBtnText = document.getElementById('copyBtnText');

      function handleProcess() {
        if (inputText && outputText) {
          outputText.value = transformText(inputText.value, slug);
        }
      }

      if (inputText) {
        inputText.addEventListener('input', handleProcess);
        handleProcess();
      }

      if (copyBtn && copyBtnText) {
        copyBtn.addEventListener('click', () => {
          if (outputText && outputText.value) {
            navigator.clipboard.writeText(outputText.value).then(() => {
              const originalText = copyBtnText.textContent;
              copyBtnText.textContent = 'Copied!';
              setTimeout(() => {
                copyBtnText.textContent = originalText;
              }, 1500);
            });
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScript);
    } else {
      initScript();
    }
  </script>
</Layout>